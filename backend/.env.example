# ==============================================================================
# WorkHealth AI — Backend Environment Configuration Example
# Copy this file to .env and configure your production credentials.
# NEVER commit the actual .env file with production secrets to version control.
# ==============================================================================

# Core Database Configuration (SQLite default or PostgreSQL connection string)
DATABASE_URL=sqlite:///./occupational_health.db
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/occupational_health

# Security & Session Secrets
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Real SMTP Email Provider Configuration (e.g. Gmail App Password, AWS SES, SendGrid, Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME="WorkHealth AI"
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Frontend URL for links in email notifications
FRONTEND_URL=http://localhost:5173

# Admin Initial Bootstrap Credentials (Created if no admin exists)
ADMIN_BOOTSTRAP_EMAIL=admin@company.com
ADMIN_BOOTSTRAP_PASSWORD=Corporate2026!
ADMIN_BOOTSTRAP_NAME="Health Directorate Administrator"

# Employee Registration Approval Policy ("automatic" or "manual")
EMPLOYEE_APPROVAL_POLICY=automatic
